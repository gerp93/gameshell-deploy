# decrypted backups should never be committed anywhere
*.sql

# games/APP_NAME/backups/ holds operator-local database dumps (encrypted
# and decrypted alike) — only games/APP_NAME/deploy.conf and the empty
# backups/ dir itself (via .gitkeep) are tracked
games/*/backups/*
!games/*/backups/.gitkeep

# last create.sh/delete.sh output written by the GUI — operator-local, same
# as backups: useful after a failed run, not shared tooling
games/*/last-create.log
games/*/last-delete.log
games/*/last-redeploy.log

# gui/ (Wails app) build artifacts and generated bindings
gui/frontend/dist/
gui/frontend/node_modules/
gui/frontend/wailsjs/
gui/build/bin/

# secrets — KVG_Standards secrets.md baseline. Tracked config holds secret
# NAMES only (deploy.conf.template / EXTRA_ENV_VARS); values come from the
# operator's environment, and the holocron ssh target from
# ~/.config/kvguzzler/deploy.env outside this repo.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
